DB_BACKEND=sqlite                 # sqlite（当前唯一实现） | mysql（规划中）
DB_PATH=                          # SQLite 文件路径（默认 backend/data.db）
SECRET_KEY=dev-secret             # JWT 密钥
# AI 定性分析（app/ai_analyze，DeepSeek ReAct 模式）
DEEPSEEK_API_KEY=                 # DeepSeek API Key（必填）
DEEPSEEK_BASE_URL=https://api.deepseek.com  # 兼容网关/代理可改为托管地址
DEEPSEEK_MODEL=deepseek-v4-pro    # flash 更快更省；pro 推理更强
# 以下为未来接入 MySQL 时使用（当前未实现，可忽略）
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=ifund
